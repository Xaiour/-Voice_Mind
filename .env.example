# ============================
# VoiceMind Environment Config
# ============================

# App
NODE_ENV=development
APP_NAME=VoiceMind
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
VOICE_SERVICE_URL=http://localhost:8001

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/voicemind?retryWrites=true&w=majority

# Redis (Upstash)
REDIS_URL=
UPSTASH_REDIS_REST_URL=https://<region>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<token>

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=30d

# AI Provider (choose one)
# Set AI_PROVIDER=gemini for FREE (no card needed) — recommended
# Set AI_PROVIDER=openai if you have billing enabled
AI_PROVIDER=gemini

# Google Gemini (FREE - no credit card required!)
# Get key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy-your-gemini-key
GEMINI_MODEL=gemini-2.0-flash

# OpenAI (requires credit card / billing)
# Get your key from: https://platform.openai.com/api-keys
# FREE TIER keys: use OPENAI_MODEL=gpt-3.5-turbo (gpt-4o requires paid plan)
# PAID keys: can use gpt-4o, gpt-4o-mini, gpt-4-turbo, etc.
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=50mb
ALLOWED_AUDIO_TYPES=audio/wav,audio/mp3,audio/mpeg,audio/ogg,audio/webm

# Python Voice Service
VOICE_MODEL_PATH=./models
VOICE_ANALYSIS_TIMEOUT=30000

# Session Config
SESSION_TTL=86400
RATE_LIMIT_WINDOW=900
RATE_LIMIT_MAX=100

# Email (optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Sentry (optional - error tracking)
SENTRY_DSN=https://your-sentry-dsn
